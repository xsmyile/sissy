#pragma once

// Optional compile-time defaults. WiFiManager portal will let the user override
// these at runtime — values get saved to NVS and survive reboots.
// Copy this file to firmware/include/secrets.h and edit. The real file is gitignored.

#define DEFAULT_SERVER_HOST   "sissy.local"   // mDNS hostname of the Mac
#define DEFAULT_SERVER_PORT   8787
#define DEFAULT_SERVER_PATH   "/ws"
#define DEFAULT_AUTH_TOKEN    ""                  // leave empty to force portal entry
#define DEFAULT_OTA_PASSWORD  ""                  // leave empty to generate a strong runtime value
